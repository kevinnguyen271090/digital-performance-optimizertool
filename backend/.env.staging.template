# ========================================
# Digital Performance Optimizer - Backend STAGING
# ========================================
# Copy this file to .env.staging and replace placeholders with actual values

# Application Settings
DEBUG=true
ENVIRONMENT=staging
PRODUCTION=false
TESTING=false
PORT=8000
HOST=0.0.0.0
PROTOCOL=https
DOMAIN=staging.digitalmkthub.com
WORKERS=2
RELOAD=false

# Security
SECRET_KEY=your-secret-key-change-this
ALLOWED_HOSTS=["staging.digitalmkthub.com","*.digitalmkthub.com"]

# Database Configuration (Replace with your Supabase credentials)
DATABASE_URL=postgresql://user:password@host:6543/postgres?sslmode=require
DIRECT_URL=postgresql://user:password@host:5432/postgres?sslmode=require

# Supabase Configuration (Replace with your Supabase credentials)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-key
SUPABASE_JWT_KEY=your-jwt-secret-key
SUPABASE_JWT_AUDIENCE=authenticated

# Redis Configuration
REDIS_URL=redis://staging-redis.digitalmkthub.com:6379
REDIS_HOST=staging-redis.digitalmkthub.com
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Celery Configuration
CELERY_BROKER_URL=redis://staging-redis.digitalmkthub.com:6379/0
CELERY_RESULT_BACKEND=redis://staging-redis.digitalmkthub.com:6379/0

# Cache Settings
CACHE_ENABLED=true
CACHE_TTL=3600

# CORS Configuration
CORS_ORIGINS=["https://staging.digitalmkthub.com","https://staging-app.digitalmkthub.com"]
FRONTEND_URL=https://staging.digitalmkthub.com

# Google OAuth & APIs (Replace with your credentials)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=https://staging.digitalmkthub.com/auth/oauth/callback
GOOGLE_ADS_SCOPE=https://www.googleapis.com/auth/adwords
GOOGLE_ADS_DEVELOPER_TOKEN=your-developer-token
GOOGLE_SERVICE_ACCOUNT_CREDENTIALS_B64=your-base64-encoded-credentials

# Meta/Facebook Configuration (Replace with your credentials)
META_APP_ID=your-app-id
META_APP_SECRET=your-app-secret
META_REDIRECT_URI=https://staging.digitalmkthub.com/auth/oauth/callback

# TikTok Configuration (Replace with your credentials)
TIKTOK_CLIENT_KEY=your-client-key
TIKTOK_CLIENT_SECRET=your-client-secret
TIKTOK_REDIRECT_URI=https://staging.digitalmkthub.com/auth/oauth/callback

# WooCommerce Configuration
WOOCOMMERCE_REDIRECT_URI=https://staging.digitalmkthub.com/auth/oauth/callback

# Email Configuration
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-email-password
FROM_EMAIL=info@example.com

# Email Templates
WELCOME_EMAIL_SUBJECT=Chào mừng đến với Digital Performance Optimizer!
EMAIL_VERIFICATION_SUBJECT=Xác thực tài khoản - Digital Performance Optimizer
PASSWORD_RESET_SUBJECT=Đặt lại mật khẩu - Digital Performance Optimizer

# Email Rate Limiting
EMAIL_RATE_LIMIT_PER_HOUR=100
EMAIL_RATE_LIMIT_PER_DAY=1000

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# Monitoring & Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
SENTRY_DSN=your-sentry-dsn
PROMETHEUS_PORT=9090
