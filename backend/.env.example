# ========================================
# Digital Performance Optimizer - Backend
# ========================================

# Application Settings
DEBUG=true
ENVIRONMENT=development
PRODUCTION=false
TESTING=false
PORT=8000
HOST=0.0.0.0
PROTOCOL=http
DOMAIN=localhost
WORKERS=1
RELOAD=true

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ALLOWED_HOSTS=["localhost","0.0.0.0"]

# Database Configuration
DATABASE_URL=postgresql://user:password@host:port/database
DIRECT_URL=postgresql://user:password@host:port/database

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-key
SUPABASE_JWT_KEY=your-jwt-secret-key
SUPABASE_JWT_AUDIENCE=authenticated

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Celery Configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Cache Settings
CACHE_ENABLED=true
CACHE_TTL=3600

# CORS Configuration
CORS_ORIGINS=["https://localhost:3000","https://localhost:5173","https://localhost:3000","https://127.0.0.1:3000"]
FRONTEND_URL=https://localhost:3000

# Google OAuth & APIs
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://localhost:3000/auth/oauth/callback
GOOGLE_ADS_SCOPE=https://www.googleapis.com/auth/adwords
GOOGLE_ADS_DEVELOPER_TOKEN=your-google-ads-developer-token
GOOGLE_SERVICE_ACCOUNT_CREDENTIALS_B64=your-base64-encoded-service-account-json

# Meta/Facebook Configuration
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
META_REDIRECT_URI=https://localhost:3000/auth/oauth/callback

# TikTok Configuration
TIKTOK_CLIENT_KEY=your-tiktok-client-key
TIKTOK_CLIENT_SECRET=your-tiktok-client-secret
TIKTOK_REDIRECT_URI=https://localhost:3000/auth/oauth/callback

# WooCommerce Configuration
WOOCOMMERCE_REDIRECT_URI=https://localhost:3000/auth/oauth/callback

# Email Configuration (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-email-password
FROM_EMAIL=info@example.com

# Email Templates
WELCOME_EMAIL_SUBJECT=Chào mừng đến với Digital Performance Optimizer!
EMAIL_VERIFICATION_SUBJECT=Xác thực tài khoản - Digital Performance Optimizer
PASSWORD_RESET_SUBJECT=Đặt lại mật khẩu - Digital Performance Optimizer

# Email Rate Limiting
EMAIL_RATE_LIMIT_PER_HOUR=100
EMAIL_RATE_LIMIT_PER_DAY=1000

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# Monitoring & Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
SENTRY_DSN=your-sentry-dsn
PROMETHEUS_PORT=9090

# ========================================
# HƯỚNG DẪN SETUP
# ========================================
# 1. Copy file này thành .env
# 2. Thay thế các giá trị placeholder bằng credentials thực
# 3. Đảm bảo file .env KHÔNG được commit vào git
# 4. Chạy: uvicorn app.main:app --reload
